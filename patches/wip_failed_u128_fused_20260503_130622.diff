+
+// U128_FUSED_CACHED_PATCH_BEGIN
+// Cached + fused specialized u128 SumCheck path.
+// Main goals:
+//   1. avoid to_mont(x) inside the hot point loop
+//   2. load each row endpoint pair once per idx
+//   3. compute all x=0..degree values from cached zero/delta
+//   4. fuse MLE update into the eval pass
+constexpr int U128_SPEC_MAX_ROWS = 19;
+
+__device__ __forceinline__ u128x small_x_to_mont_u128(int x) {
+  // q = 2^128 - 159, so R mod q = 159.
+  // For x <= 7, xR mod q = 159*x and fits in one limb.
+  return {static_cast<u64>(x) * MONT_ONE_LO, 0ULL};
+}
+
+__device__ __forceinline__ u128x line_eval_delta_mont_u128(
+    u128x zero_eval,
+    u128x delta_eval,
+    u128x x_mont) {
+  return add_mod_u128(zero_eval, mont_mul(x_mont, delta_eval));
+}
+
+__device__ __forceinline__ u128x eval_hyperplonk_poly_cached_u128(
+    const u128x* __restrict__ z,
+    const u128x* __restrict__ delta,
+    int poly_id,
+    u128x x_mont) {
+#define U128_AT(row_) line_eval_delta_mont_u128(z[(row_)], delta[(row_)], x_mont)
+
+  u128x acc{0ULL, 0ULL};
+
+  if (poly_id == 8) {
+    return U128_AT(0);
+  }
+
+  if (poly_id == 9) {
+    u128x a = U128_AT(0);
+    u128x b = U128_AT(1);
+    return prod2_spec_u128(a, b);
+  }
+
+  if (poly_id == 10) {
+    u128x a = U128_AT(0);
+    u128x b = U128_AT(1);
+    u128x c = U128_AT(2);
+    return add_mod_u128(prod2_spec_u128(a, b), c);
+  }
+
+  if (poly_id == 11) {
+    u128x a = U128_AT(0);
+    u128x b = U128_AT(1);
+    u128x c = U128_AT(2);
+    return prod3_spec_u128(a, b, c);
+  }
+
+  if (poly_id == 12) {
+    u128x a = U128_AT(0);
+    u128x b = U128_AT(1);
+    u128x c = U128_AT(2);
+    return prod5_spec_u128(a, a, b, b, c);
+  }
+
+  if (poly_id == 13) {
+    u128x a = U128_AT(0);
+    u128x b = U128_AT(1);
+    u128x c = U128_AT(2);
+    u128x d = U128_AT(3);
+    u128x e = U128_AT(4);
+    return add_mod_u128(prod3_spec_u128(a, b, c), prod2_spec_u128(d, e));
+  }
+
+  if (poly_id == 14) {
+    u128x a = U128_AT(0);
+    u128x b = U128_AT(1);
+    u128x c = U128_AT(2);
+    u128x d = U128_AT(3);
+    u128x e = U128_AT(4);
+    u128x g = U128_AT(5);
+    return add_mod_u128(prod4_spec_u128(a, b, c, g), prod3_spec_u128(d, e, g));
+  }
+
+  if (poly_id == 0) {
+    u128x qL  = U128_AT(0);
+    u128x w1  = U128_AT(1);
+    u128x qR  = U128_AT(2);
+    u128x w2  = U128_AT(3);
+    u128x qM  = U128_AT(4);
+    u128x nqO = U128_AT(5);
+    u128x w3  = U128_AT(6);
+    u128x qC  = U128_AT(7);
+
+    acc = add_mod_u128(acc, prod2_spec_u128(qL, w1));
+    acc = add_mod_u128(acc, prod2_spec_u128(qR, w2));
+    acc = add_mod_u128(acc, prod3_spec_u128(qM, w1, w2));
+    acc = add_mod_u128(acc, prod2_spec_u128(nqO, w3));
+    acc = add_mod_u128(acc, qC);
+    return acc;
+  }
+
+  if (poly_id == 1) {
+    u128x qL  = U128_AT(0);
+    u128x w1  = U128_AT(1);
+    u128x qR  = U128_AT(2);
+    u128x w2  = U128_AT(3);
+    u128x qM  = U128_AT(4);
+    u128x nqO = U128_AT(5);
+    u128x w3  = U128_AT(6);
+    u128x qC  = U128_AT(7);
+    u128x fr  = U128_AT(8);
+
+    acc = add_mod_u128(acc, prod3_spec_u128(qL, w1, fr));
+    acc = add_mod_u128(acc, prod3_spec_u128(qR, w2, fr));
+    acc = add_mod_u128(acc, prod4_spec_u128(qM, w1, w2, fr));
+    acc = add_mod_u128(acc, prod3_spec_u128(nqO, w3, fr));
+    acc = add_mod_u128(acc, prod2_spec_u128(qC, fr));
+    return acc;
+  }
+
+  if (poly_id == 2) {
+    u128x pi   = U128_AT(0);
+    u128x np1  = U128_AT(1);
+    u128x p2   = U128_AT(2);
+    u128x aphi = U128_AT(3);
+    u128x D1   = U128_AT(4);
+    u128x D2   = U128_AT(5);
+    u128x D3   = U128_AT(6);
+    u128x nN1  = U128_AT(7);
+    u128x N2   = U128_AT(8);
+    u128x N3   = U128_AT(9);
+    u128x fr   = U128_AT(10);
+
+    acc = add_mod_u128(acc, prod2_spec_u128(pi, fr));
+    acc = add_mod_u128(acc, prod3_spec_u128(np1, p2, fr));
+    acc = add_mod_u128(acc, prod5_spec_u128(aphi, D1, D2, D3, fr));
+    acc = add_mod_u128(acc, prod4_spec_u128(nN1, N2, N3, fr));
+    return acc;
+  }
+
+  if (poly_id == 3) {
+#pragma unroll
+    for (int r = 0; r < 6; ++r) {
+      acc = add_mod_u128(acc, U128_AT(r));
+    }
+    return acc;
+  }
+
+  if (poly_id == 5 || poly_id == 6 || poly_id == 7) {
+    u128x q1 = U128_AT(0);
+    u128x w1 = U128_AT(1);
+    u128x q2 = U128_AT(2);
+    u128x w2 = U128_AT(3);
+    u128x qH = U128_AT(4);
+    u128x qC = U128_AT(5);
+
+    acc = add_mod_u128(acc, prod2_spec_u128(q1, w1));
+    acc = add_mod_u128(acc, prod2_spec_u128(q2, w2));
+
+    if (poly_id == 5) {
+      acc = add_mod_u128(acc, prod3_spec_u128(qH, w1, w2));
+    } else if (poly_id == 6) {
+      acc = add_mod_u128(acc, prod5_spec_u128(qH, w1, w1, w1, w2));
+    } else {
+      acc = add_mod_u128(acc, prod7_spec_u128(qH, w1, w1, w1, w1, w1, w2));
+    }
+
+    acc = add_mod_u128(acc, qC);
+    return acc;
+  }
+
+#undef U128_AT
+  return {0ULL, 0ULL};
+}
+
+__global__ void eval_hyperplonk_sumcheck_u128_fused_cached_kernel(
+    const u64* __restrict__ tables_lo,
+    const u64* __restrict__ tables_hi,
+    int len,
+    int rows,
+    int poly_id,
+    int degree,
+    const u64* __restrict__ chals_lo,
+    const u64* __restrict__ chals_hi,
+    int round,
+    u64* __restrict__ next_lo,
+    u64* __restrict__ next_hi,
+    u64* __restrict__ partials_lo,
+    u64* __restrict__ partials_hi) {
+  extern __shared__ u64 shared[];
+
+  const int tid = threadIdx.x;
+  const int lane = tid & 31;
+  const int warp_id = tid >> 5;
+  const int num_warps = (blockDim.x + 31) >> 5;
+  const int half = len >> 1;
+  const bool do_update = (next_lo != nullptr) && (next_hi != nullptr);
+
+  u128x challenge{0ULL, 0ULL};
+  if (do_update) {
+    challenge = {chals_lo[round], chals_hi[round]};
+  }
+
+  u128x local[8];
+#pragma unroll
+  for (int x = 0; x < 8; ++x) {
+    local[x] = {0ULL, 0ULL};
+  }
+
+  for (int i = blockIdx.x * blockDim.x + tid;
+       i < half;
+       i += blockDim.x * gridDim.x) {
+    u128x z[U128_SPEC_MAX_ROWS];
+    u128x delta[U128_SPEC_MAX_ROWS];
+
+#pragma unroll
+    for (int row = 0; row < U128_SPEC_MAX_ROWS; ++row) {
+      if (row < rows) {
+        const size_t base =
+            static_cast<size_t>(row) * static_cast<size_t>(len);
+        u128x zero_eval{tables_lo[base + i], tables_hi[base + i]};
+        u128x one_eval{
+            tables_lo[base + i + half],
+            tables_hi[base + i + half]};
+        z[row] = zero_eval;
+        delta[row] = sub_mod_u128(one_eval, zero_eval);
+      } else {
+        z[row] = {0ULL, 0ULL};
+        delta[row] = {0ULL, 0ULL};
+      }
+    }
+
+#pragma unroll
+    for (int x = 0; x < 8; ++x) {
+      if (x <= degree) {
+        const u128x x_mont = small_x_to_mont_u128(x);
+        u128x y = eval_hyperplonk_poly_cached_u128(
+            z, delta, poly_id, x_mont);
+        local[x] = add_mod_u128(local[x], y);
+      }
+    }
+
+    if (do_update) {
+#pragma unroll
+      for (int row = 0; row < U128_SPEC_MAX_ROWS; ++row) {
+        if (row < rows) {
+          const size_t out_base =
+              static_cast<size_t>(row) * static_cast<size_t>(half);
+          u128x folded = line_eval_delta_mont_u128(
+              z[row], delta[row], challenge);
+          next_lo[out_base + i] = folded.lo;
+          next_hi[out_base + i] = folded.hi;
+        }
+      }
+    }
+  }
+
+#pragma unroll
+  for (int x = 0; x < 8; ++x) {
+    if (x <= degree) {
+      u128x reduced = warp_reduce_add_mod_u128(local[x]);
+      if (lane == 0) {
+        int slot = (x * num_warps + warp_id) * 2;
+        shared[slot + 0] = reduced.lo;
+        shared[slot + 1] = reduced.hi;
+      }
+    }
+  }
+
+  __syncthreads();
+
+  if (warp_id == 0) {
+#pragma unroll
+    for (int x = 0; x < 8; ++x) {
+      if (x <= degree) {
+        u128x value{0ULL, 0ULL};
+
+        if (lane < num_warps) {
+          int slot = (x * num_warps + lane) * 2;
+          value.lo = shared[slot + 0];
+          value.hi = shared[slot + 1];
+        }
+
+        value = warp_reduce_add_mod_u128(value);
+
+        if (lane == 0) {
+          const size_t out_idx =
+              static_cast<size_t>(blockIdx.x) *
+                  static_cast<size_t>(degree + 1) +
+              static_cast<size_t>(x);
+          partials_lo[out_idx] = value.lo;
+          partials_hi[out_idx] = value.hi;
+        }
+      }
+    }
+  }
+}
+// U128_FUSED_CACHED_PATCH_END
+
