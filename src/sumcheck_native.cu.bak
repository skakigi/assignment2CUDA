#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <c10/cuda/CUDAGuard.h>

#include <cstdint>
#include <stdexcept>
#include <string>

namespace {

using u64 = unsigned long long;
constexpr int THREADS = 128;
constexpr int MAX_DEGREE = 32;
constexpr int MAX_BLOCKS = 4096;

__device__ __forceinline__ u64 mod_add(u64 a, u64 b, u64 p) {
    u64 s = a + b;
    // Handles both normal overflow and sum >= p.
    if (s < a || s >= p) s -= p;
    return s;
}

__device__ __forceinline__ u64 mod_sub(u64 a, u64 b, u64 p) {
    return (a >= b) ? (a - b) : (p - (b - a));
}

__device__ __forceinline__ u64 mod_mul(u64 a, u64 b, u64 p) {
#if defined(__SIZEOF_INT128__)
    unsigned __int128 z = static_cast<unsigned __int128>(a) * static_cast<unsigned __int128>(b);
    return static_cast<u64>(z % static_cast<unsigned __int128>(p));
#else
    // Fallback: double-and-add. This is slower but keeps the kernel correct on
    // toolchains without device int128 support.
    u64 res = 0;
    a %= p;
    while (b) {
        if (b & 1ULL) res = mod_add(res, a, p);
        b >>= 1ULL;
        if (b) a = mod_add(a, a, p);
    }
    return res;
#endif
}

__global__ void round_eval_kernel(
    const u64* __restrict__ tables,
    int num_tables,
    int len,
    int degree,
    u64 modulus,
    u64* __restrict__ partials) {

    extern __shared__ u64 shared[];  // (degree + 1) * blockDim.x
    const int tid = threadIdx.x;
    const int pair_count = len >> 1;

    u64 local[MAX_DEGREE + 1];
#pragma unroll
    for (int e = 0; e <= MAX_DEGREE; ++e) {
        if (e <= degree) local[e] = 0ULL;
    }

    for (int pair = blockIdx.x * blockDim.x + tid;
         pair < pair_count;
         pair += gridDim.x * blockDim.x) {
        const int base = pair << 1;

        for (int x = 0; x <= degree; ++x) {
            u64 prod = 1ULL % modulus;
            const u64 x_field = static_cast<u64>(x);
            for (int t = 0; t < num_tables; ++t) {
                const u64* row = tables + static_cast<size_t>(t) * static_cast<size_t>(len);
                const u64 a = row[base];
                const u64 b = row[base + 1];
                const u64 delta = mod_sub(b, a, modulus);
                const u64 val = mod_add(a, mod_mul(delta, x_field, modulus), modulus);
                prod = mod_mul(prod, val, modulus);
            }
            local[x] = mod_add(local[x], prod, modulus);
        }
    }

    for (int x = 0; x <= degree; ++x) {
        shared[x * blockDim.x + tid] = local[x];
    }
    __syncthreads();

    for (int stride = blockDim.x >> 1; stride > 0; stride >>= 1) {
        if (tid < stride) {
            for (int x = 0; x <= degree; ++x) {
                u64* row = shared + x * blockDim.x;
                row[tid] = mod_add(row[tid], row[tid + stride], modulus);
            }
        }
        __syncthreads();
    }

    if (tid == 0) {
        for (int x = 0; x <= degree; ++x) {
            partials[static_cast<size_t>(blockIdx.x) * (degree + 1) + x] = shared[x * blockDim.x];
        }
    }
}

__global__ void reduce_partials_kernel(
    const u64* __restrict__ partials,
    int num_blocks,
    int degree,
    u64 modulus,
    u64* __restrict__ out_round) {

    const int x = blockIdx.x;
    const int tid = threadIdx.x;
    __shared__ u64 scratch[THREADS];

    u64 acc = 0ULL;
    for (int b = tid; b < num_blocks; b += blockDim.x) {
        acc = mod_add(acc, partials[static_cast<size_t>(b) * (degree + 1) + x], modulus);
    }
    scratch[tid] = acc;
    __syncthreads();

    for (int stride = blockDim.x >> 1; stride > 0; stride >>= 1) {
        if (tid < stride) {
            scratch[tid] = mod_add(scratch[tid], scratch[tid + stride], modulus);
        }
        __syncthreads();
    }
    if (tid == 0) out_round[x] = scratch[0];
}

__global__ void update_kernel(
    const u64* __restrict__ in_tables,
    int num_tables,
    int len,
    const u64* __restrict__ challenges,
    int round,
    u64 modulus,
    u64* __restrict__ out_tables) {

    const int pair_count = len >> 1;
    const size_t total = static_cast<size_t>(num_tables) * static_cast<size_t>(pair_count);

    for (size_t linear = static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
         linear < total;
         linear += static_cast<size_t>(gridDim.x) * blockDim.x) {
        const int t = static_cast<int>(linear / pair_count);
        const int pair = static_cast<int>(linear - static_cast<size_t>(t) * pair_count);
        const u64* in_row = in_tables + static_cast<size_t>(t) * static_cast<size_t>(len);
        u64* out_row = out_tables + static_cast<size_t>(t) * static_cast<size_t>(pair_count);

        const u64 a = in_row[pair << 1];
        const u64 b = in_row[(pair << 1) + 1];
        const u64 delta = mod_sub(b, a, modulus);
        const u64 challenge = challenges[round] % modulus;
        out_row[pair] = mod_add(a, mod_mul(delta, challenge, modulus), modulus);
    }
}

bool is_power_of_two(int64_t x) {
    return x > 0 && (x & (x - 1)) == 0;
}

int log2_exact(int64_t x) {
    int r = 0;
    while (x > 1) {
        x >>= 1;
        ++r;
    }
    return r;
}

void check_cuda_error(const char* label) {
    cudaError_t err = cudaGetLastError();
    if (err != cudaSuccess) {
        throw std::runtime_error(std::string(label) + ": " + cudaGetErrorString(err));
    }
}

}  // namespace


torch::Tensor sumcheck_cuda(torch::Tensor eval_tables, torch::Tensor challenges, uint64_t modulus) {
    if (modulus <= 1) throw std::invalid_argument("modulus must be > 1");
    if (!eval_tables.is_cuda()) throw std::invalid_argument("eval_tables must be a CUDA tensor");
    if (eval_tables.scalar_type() != torch::kUInt64) throw std::invalid_argument("eval_tables must have dtype torch.uint64");
    if (eval_tables.dim() != 2) throw std::invalid_argument("eval_tables must have shape (num_tables, table_len)");
    if (eval_tables.size(0) < 1) throw std::invalid_argument("num_tables must be >= 1");
    if (eval_tables.size(0) > MAX_DEGREE) throw std::invalid_argument("num_tables exceeds MAX_DEGREE=32; raise MAX_DEGREE and rebuild");
    if (!is_power_of_two(eval_tables.size(1))) throw std::invalid_argument("table_len must be a power of two");

    const c10::cuda::CUDAGuard device_guard(eval_tables.device());
    auto tables = eval_tables.contiguous();
    auto rs = challenges.to(eval_tables.options().dtype(torch::kUInt64)).contiguous();

    const int num_tables = static_cast<int>(tables.size(0));
    const int initial_len = static_cast<int>(tables.size(1));
    const int rounds = log2_exact(initial_len);
    const int degree = num_tables;

    if (rs.dim() != 1 || rs.size(0) != rounds) {
        throw std::invalid_argument("challenges must have shape (log2(table_len),)");
    }

    auto output = torch::empty({rounds, degree + 1}, tables.options());
    auto current = tables;

    cudaStream_t stream = at::cuda::getCurrentCUDAStream();

    for (int round = 0; round < rounds; ++round) {
        const int len = static_cast<int>(current.size(1));
        const int pair_count = len >> 1;
        const int blocks = std::min(MAX_BLOCKS, std::max(1, (pair_count + THREADS - 1) / THREADS));

        auto partials = torch::empty({blocks, degree + 1}, tables.options());
        const size_t shmem = static_cast<size_t>(degree + 1) * THREADS * sizeof(u64);
        round_eval_kernel<<<blocks, THREADS, shmem, stream>>>(
            reinterpret_cast<const u64*>(current.data_ptr<uint64_t>()),
            num_tables,
            len,
            degree,
            static_cast<u64>(modulus),
            reinterpret_cast<u64*>(partials.data_ptr<uint64_t>()));
        check_cuda_error("round_eval_kernel launch failed");

        reduce_partials_kernel<<<degree + 1, THREADS, 0, stream>>>(
            reinterpret_cast<const u64*>(partials.data_ptr<uint64_t>()),
            blocks,
            degree,
            static_cast<u64>(modulus),
            reinterpret_cast<u64*>(output[round].data_ptr<uint64_t>()));
        check_cuda_error("reduce_partials_kernel launch failed");

        if (round + 1 < rounds) {
            auto next = torch::empty({num_tables, pair_count}, tables.options());
            const int upd_blocks = std::min(MAX_BLOCKS, std::max(1, (num_tables * pair_count + THREADS - 1) / THREADS));
            update_kernel<<<upd_blocks, THREADS, 0, stream>>>(
                reinterpret_cast<const u64*>(current.data_ptr<uint64_t>()),
                num_tables,
                len,
                reinterpret_cast<const u64*>(rs.data_ptr<uint64_t>()),
                round,
                static_cast<u64>(modulus),
                reinterpret_cast<u64*>(next.data_ptr<uint64_t>()));
            check_cuda_error("update_kernel launch failed");
            current = next;
        }
    }

    return output;
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
    m.def("sumcheck_cuda", &sumcheck_cuda, "CUDA SumCheck for product-of-MLE tables");
}
